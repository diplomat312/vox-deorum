.DS_STORE
coverage
node_modules
dist
/node
/temp
/logs
.tmp/
.env
nul

# Local installed/runtime snapshots kept for comparison, not source control.
/runtime/
/implementation/

# Oracle telemetry output (also ignored in vox-agents/.gitignore; covered here
# in case a run writes it at the repo root)
/telemetry/

# Harness run logs (its logger writes logs/ beside whatever directory it runs from).
/opencode-harness/logs/

# Harness run artifacts: transcripts, traces and per-seat session state.
/opencode-harness/runs/

# Harness matrix artifacts: the same, for a variant played across several seeds.
/opencode-harness/matrix/

# DLL cache directory
scripts/.dll-cache
/*.bat

# Local junction so Claude Code discovers skills under .agents/skills/.
# Source of truth is .agents/skills/; this link is machine-local (recreate with
# `mklink /J .claude\skills .agents\skills`).
.claude/skills/

# Local agent handoffs and standalone social sandbox databases.
.codex-handoff/
/vox-agents/social-data/

# Social sandbox runtime state (sessions, messages, cascades).
/social-data/

# Compiled output that must never sit beside source. A build with the wrong
# rootDir once emitted these into the harness source tree.
/opencode-harness/src/**/*.js
/opencode-harness/src/**/*.js.map
/opencode-harness/src/**/*.d.ts
/opencode-harness/src/**/*.d.ts.map

# Benchmark output. The transcripts and measures are worth keeping; the session
# databases and the per-seat session state are not.
/runs-sim/*/store/

