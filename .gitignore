.DS_STORE
coverage
node_modules
dist
/node
/temp
/logs
.tmp/
.env
nul

# Local installed/runtime snapshots kept for comparison, not source control.
/runtime/
/implementation/

# Oracle telemetry output (also ignored in vox-agents/.gitignore; covered here
# in case a run writes it at the repo root)
/telemetry/

# DLL cache directory

# Pilot runtime control files: process coordination, never source.
/experiments/opencode-civ-pilot/live/STOP-ROUTER
/experiments/opencode-civ-pilot/live/*/STOP
/experiments/opencode-civ-pilot/live/router-*.lock
/experiments/opencode-civ-pilot/live/*.tmp
scripts/.dll-cache
/*.bat

# Local junction so Claude Code discovers skills under .agents/skills/.
# Source of truth is .agents/skills/; this link is machine-local (recreate with
# `mklink /J .claude\skills .agents\skills`).
.claude/skills/
